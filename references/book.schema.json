{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bookgraph 非虚构书数据",
  "type": "object",
  "required": ["title", "claimTypes", "relTypes", "chapters", "claims", "links", "outline"],
  "properties": {
    "profile": {"const": "nonfiction"},
    "title": {"type": "string"},
    "subtitle": {"type": "string"},
    "author": {"type": "string"},
    "thesis": {"type": "string", "description": "一句话全书主张"},
    "claimTypes": {"type": "object", "additionalProperties": {"type": "string"}},
    "relTypes": {"type": "object", "additionalProperties": {"type": "string"}},
    "chapters": {"type": "object", "additionalProperties": {"type": "string"}, "description": "章键 -> 章标题,键的顺序即书中顺序"},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "h", "t", "ty", "ch", "basis"],
        "properties": {
          "id": {"type": "string"},
          "h": {"type": "string", "maxLength": 10, "description": "短标签,图上显示"},
          "t": {"type": "string", "minLength": 10, "description": "完整句子,转述而非原文"},
          "ty": {"type": "string", "description": "命题类型键,须在 claimTypes 中"},
          "ch": {"type": "string", "description": "所属章键,须在 chapters 中"},
          "basis": {"enum": ["e", "x"], "description": "e=书中明确写出;x=作者经历/案例等外部依据"}
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["s", "t", "ty", "basis"],
        "properties": {
          "s": {"type": "string", "description": "起点命题 id(先说的)"},
          "t": {"type": "string", "description": "终点命题 id(后说的)"},
          "ty": {"type": "string", "description": "关系类型键,须在 relTypes 中"},
          "basis": {"enum": ["e", "i"], "description": "e=书中明确;i=推断(虚线)"},
          "note": {"type": "string"}
        }
      }
    },
    "outline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "chapters"],
        "properties": {
          "id": {"type": "string"}, "label": {"type": "string"}, "sub": {"type": "string"},
          "color": {"type": "string"}, "thesis": {"type": "string"},
          "chapters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["k", "title", "points"],
              "properties": {
                "k": {"type": "string"}, "title": {"type": "string"}, "takeaway": {"type": "string"},
                "points": {"type": "array", "items": {
                  "type": "object", "required": ["text", "claims"],
                  "properties": {"text": {"type": "string"}, "claims": {"type": "array", "items": {"type": "string"}}}
                }}
              }
            }
          }
        }
      }
    }
  }
}
